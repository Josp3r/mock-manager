{
  "name": "mock-manager",
  "version": "0.2.0",
  "private": true,
  "description": "Personal desktop API mock and scenario manager",
  "author": "Mock Manager",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs && node scripts/build-native.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:desktop": "node scripts/desktop-test.mjs",
    "package:mac": "npm run build && node scripts/package-app.mjs --platform darwin",
    "test:system-proxy:desktop": "node --import tsx scripts/system-proxy-desktop-test.mjs",
    "test:engine": "node scripts/build-electron.mjs && node scripts/embedded-engine-test.mjs",
    "test:i18n:desktop": "node scripts/i18n-desktop-test.mjs",
    "package:mac:arm64": "npm run build && node scripts/package-app.mjs --platform darwin --arch arm64",
    "package:mac:x64": "npm run build && node scripts/package-app.mjs --platform darwin --arch x64",
    "package:win": "npm run build && node scripts/package-app.mjs --platform win32 --arch x64",
    "test:packaged": "node scripts/packaged-test.mjs",
    "test:windows-proxy:native": "node --import tsx scripts/windows-proxy-native-test.mjs",
    "archive:release": "node scripts/archive-release.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "whistle": "2.10.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "local.whistle.mockmanager",
    "productName": "Mock Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ],
      "extraResources": [
        {
          "from": "dist-native/system-proxy",
          "to": "system-proxy"
        }
      ],
      "minimumSystemVersion": "13.0"
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "publish": null,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "src/native/windows-system-proxy.ps1",
          "to": "windows-system-proxy.ps1"
        }
      ]
    },
    "nsis": {
      "artifactName": "Mock-Manager-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
