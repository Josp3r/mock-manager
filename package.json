{
  "name": "whistle-mock-manager",
  "version": "0.1.2",
  "private": true,
  "description": "Personal desktop mock workspace for Whistle",
  "author": "Whistle Mock Manager",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs && node scripts/build-native.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:desktop": "node scripts/desktop-test.mjs",
    "package:mac": "npm run build && electron-builder --mac dir --arm64 && node scripts/sign-local.mjs",
    "test:system-proxy:desktop": "node --import tsx scripts/system-proxy-desktop-test.mjs",
    "test:engine": "node scripts/build-electron.mjs && node scripts/embedded-engine-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "whistle": "2.10.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "local.whistle.mockmanager",
    "productName": "Whistle Mock Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ]
    },
    "extraResources": [
      {
        "from": "dist-native/system-proxy",
        "to": "system-proxy"
      }
    ]
  }
}
